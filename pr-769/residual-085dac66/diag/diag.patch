+pub(crate) fn diag(msg: std::fmt::Arguments) {
+    use std::io::Write;
+    static FILE: std::sync::Mutex<Option<std::fs::File>> = std::sync::Mutex::new(None);
+    let mut g = FILE.lock().unwrap();
+    if g.is_none() { *g = std::fs::OpenOptions::new().create(true).append(true).open("/tmp/hostdiag.log").ok(); }
