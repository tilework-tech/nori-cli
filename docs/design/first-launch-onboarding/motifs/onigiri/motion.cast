[0.440, "o", "\u001b[5;25H \u001b[5;27H\u001b[2m⢀\u001b[5;29H⢀\u001b[22m \u001b[6;22H  ⡠⠰\u001b[2m⡥⢍\u001b[22m⢆\u001b[2m⢑\u001b[22m⣜\u001b[2m⠄\u001b[6;33H⡀\u001b[7;22H⡘⠞\u001b[22m⢜⢇\u001b[2m⣉⣱\u001b[22m⣳⡶\u001b[2m⠣\u001b[22m⣩⣀⠳\u001b[2m⡐⠄\u001b[8;18H\u001b[22m \u001b[2m⡠⢀⠐\u001b[22m⣓⡠⡠\u001b[2m⣗⢝⢹\u001b[22m⢎\u001b[2m⡤⣢⠵⡁\u001b[22m⣖\u001b[2m⡌⣒⢀⠄\u001b[8;39H\u001b[22m \u001b[9;17H \u001b[2m⣀⡈⠱\u001b[22m⣑\u001b[2m⡀⢺⣨⢾⠡\u001b[22m⢁⣆\u001b[2m⡙⠆⣆⣟\u001b[22m⡻\u001b[2m⡜\u001b[22m⠦⡖\u001b[2m⠄⢈⠄\u001b[22m \u001b[10;14H \u001b[2m⢀⠐\u001b[22m \u001b[2m⣠\u001b[22m⣔⢵\u001b[2m⡘\u001b[22m⢙\u001b[2m⢚⠤⢪\u001b[10;27H⠟\u001b[22m⠇\u001b[2m⠲⡳⡼⡚\u001b[22m⣊\u001b[2m⣭⠈⣫⡀⡂⡀\u001b[11;15H\u001b[22m \u001b[2m⠤⣮⠔\u001b[22m⡦\u001b[2m⠏\u001b[22m⡠⣱\u001b[2m⡔⢅⠽⢐⢘⢚⢋⠖⠕⠆⡎\u001b[22m⠸\u001b[2m⡔⡠\u001b[22m⣸\u001b[2m⣛\u001b[22m⢥\u001b[2m⣃\u001b[22m⡀\u001b[12;14H \u001b[2m⢢\u001b[22m⠾\u001b[2m⠸\u001b[12;19H⣹⣜⡎\u001b[22m⡍\u001b[2m⣋⡐⠭⡢⠮\u001b[22m⡢\u001b[2m⢄⡀⢭\u001b[12;33H⡼\u001b[22m⢂⡗⠰\u001b[2m⢨⡋\u001b[22m⣪\u001b[2m⡐⠂\u001b[13;13H\u001b[22m \u001b[2m⡱\u001b[22m⡳\u001b[2m⡠⠆⡅⡠\u001b[22m⠎\u001b[2m⠲\u001b[13;23H⢑⢞⠈⠽⡑⠆⢖⡨⡈⠢⡵⢶⠜⣍⢐⢛\u001b[22m⡛\u001b[2m⡨⡧⠆⡀\u001b[14;12H\u001b[22m \u001b[2m⣣\u001b[22m⠎\u001b[2m⡫⡥⠶⡨⢢\u001b[14;21H\u001b[22m⡙\u001b[2m⡉⡹⣨⡓⠡⢬⠣⢍⠊⢑⣅\u001b[22m⢨\u001b[2m⠎⠠⡣⢨\u001b[22m⡄⣠\u001b[2m⢕\u001b[22m \u001b[2m⡁\u001b[22m⠼\u001b[2m⡠\u001b[22m \u001b[15;10H \u001b[2m⠒\u001b[22m⡍⠺⠹⢀\u001b[2m⣌⠵⣇\u001b[22m⢮\u001b[2m⠋⣨⠆⠍⠦⣤⠃⢐⣔⣄⠢⢃⣠⡔⢢\u001b[22m⣦\u001b[2m⡫\u001b[22m⣠\u001b[2m⣅⠼⡈⠌⣮⢩⣲\u001b[22m⡄\u001b[16;9H\u001b[2m⠈⠰⣍⣭⣀⣧\u001b[22m⡭\u001b[2m⢬\u001b[22m⣁\u001b[2m⢹⠿⠓⡕⣍⠎⣷⡍⠋\u001b[22m⡰\u001b[2m⣄⣨⢂⠽⠲\u001b[22m⢡\u001b[2m⢒⣔⢓⢝⣒⢴⠃\u001b[22m⡷⡭\u001b[2m⣺\u001b[22m⣴\u001b[16;46H\u001b[2m⠠\u001b[22m \u001b[17;9H\u001b[2m⠐⠂\u001b[22m⠧⢁⠗⢉⠃\u001b[2m⣊⠳⣕⢌\u001b[17;21H\u001b[22m⡷\u001b[2m⠈⢥⠙⠫⠒⡆⠝⢊⡢⠝⡱⡮⠽⡕⡎⣥⢗\u001b[22m⢀\u001b[2m⢧\u001b[22m⠹⡼\u001b[2m⢂\u001b[22m⠓⢵⡧ \u001b[18;9H \u001b[2m⠊⠣\u001b[22m⠌⣥\u001b[2m⣯⠑⣖\u001b[22m⣵\u001b[18;19H\u001b[2m⣪⢩⠇⣺⡄⣉⡒⣱\u001b[22m⠵\u001b[2m⢁\u001b[18;30H\u001b[22m⣃\u001b[18;32H⣩⢣\u001b[2m⣆⢨\u001b[22m⣦⠶\u001b[2